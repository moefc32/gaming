---
import Layout from '../layouts/Layout.astro';
import MediaEmbed from '../components/MediaEmbed.svelte';
import Footer from '../components/Footer.astro';
---

<Layout>
    <main class="flex flex-1 flex-col gap-9 mx-18 my-12 relative">
        <div class="flex flex-col gap-6 max-w-lg">
            <h1 class="my-12 text-5xl uppercase">
                {import.meta.env.PUBLIC_APP_NAME}
            </h1>
            <p class="text-lg leading-7">
                Lorem ipsum dolor sit amet, consectetur adipiscing elit. Etiam
                euismod at diam eu luctus. Sed ut placerat justo. Nunc sagittis
                congue malesuada. Etiam ante sapien, fermentum et dolor blandit,
                egestas efficitur felis. Ut in augue ex. Phasellus auctor
                suscipit ipsum. Fusce et odio scelerisque, varius velit.
            </p>
        </div>
        <MediaEmbed client:load />
        <Footer />
    </main>
</Layout>
