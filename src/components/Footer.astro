---
import { owner } from '../lib/config';
---

<footer
    class:list={[
        '-mx-9 -mb-9 md:m-0 p-3 md:p-0 rounded-2xl md:absolute right-0 bottom-0',
        'bg-sky-700 md:bg-transparent text-white md:text-slate-600 text-center md:text-right',
    ]}
>
    <span data-copyright>{owner.displayName} &copy;</span>
</footer>

<script is:inline>
    const getYear = new Date().getFullYear();
    document.querySelector('[data-copyright]').append(` ${getYear}`);
</script>
