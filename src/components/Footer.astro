---
import { owner } from '../lib/config';
---

<footer
    class="text-slate-600 text-center lg:text-right lg:absolute right-0 bottom-0"
>
    <span data-copyright>{owner.displayName} &copy;</span>
    <span class="inline-block px-1">|</span>
    <a
        href="https://opensource.org/licenses/MIT"
        target="_blank"
        class="transition underline">MIT</a
    >
</footer>

<script is:inline>
    const getYear = new Date().getFullYear();
    document.querySelector('[data-copyright]').append(` ${getYear}`);
</script>
