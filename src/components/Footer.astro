---
import { owner } from '../lib/config';
---

<footer class="text-slate-600 text-center md:text-right md:absolute right-0 bottom-0">
    <span data-copyright>{owner.displayName} &copy;</span>
    <span class="inline-block px-1">|</span>
    <a
        href="https://opensource.org/licenses/MIT"
        target="_blank"
        class="text-blue-500 hover:text-orange-500 transition underline">MIT</a
    >
</footer>

<script is:inline>
    const getYear = new Date().getFullYear();
    const currentYear = (getYear > 2026 ? `2026 - ` : '') + getYear;

    document.querySelector('[data-copyright]').append(` ${currentYear}`);
</script>
