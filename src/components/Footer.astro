---
import { owner } from '../lib/config';
---

<footer
    class:list={[
        'flex justify-center md:justify-end -mx-6 -mb-6 md:m-0 rounded-2xl md:absolute right-0 bottom-0',
        'bg-sky-700 md:bg-transparent text-white md:text-slate-600 overflow-hidden relative',
    ]}
>
    <span class="m-3 md:m-0 z-10" data-copyright>
        {owner.displayName} &copy;
    </span>

    <div
        class="md:hidden absolute inset-0 z-0 bg-cover bg-left bg-no-repeat bg-fixed"
        data-ambience="static"
    >
    </div>
</footer>

<script>
    const getYear = new Date().getFullYear();
    document.querySelector('[data-copyright]').append(` ${getYear}`);
</script>
