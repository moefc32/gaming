<dialog id="video_modal" class="modal">
    <div
        class="modal-box p-0 bg-transparent shadow-none w-[calc(100vw-48px)] max-w-5xl overflow-hidden"
    >
        <video-player id="video_player" class="block aspect-video w-full">
            <youtube-video
                src=""
                autoplay
                playsinline
                controls
                class="block h-full w-full"></youtube-video>
        </video-player>
    </div>
    <form method="dialog" class="modal-backdrop">
        <button>close</button>
    </form>
</dialog>

<script>
    import '@videojs/html/video/player';
    import '@videojs/html/media/youtube-video';

    const videoModal = document.querySelector('#video_modal');
    const videoPlayer = document.querySelector('#video_player');
    const youtubeVideo = videoPlayer?.querySelector('youtube-video');

    function getYoutubeId(url) {
        const parsed = new URL(url);

        if (parsed.hostname === 'youtu.be') return parsed.pathname.slice(1);

        if (parsed.hostname.includes('youtube.com')) {
            if (parsed.pathname === '/watch')
                return parsed.searchParams.get('v');

            if (parsed.pathname.startsWith('/shorts/'))
                return parsed.pathname.split('/')[2];

            if (parsed.pathname.startsWith('/embed/'))
                return parsed.pathname.split('/')[2];
        }

        return null;
    }

    function playVideo(url) {
        if (
            !url ||
            !(videoModal instanceof HTMLDialogElement) ||
            !(youtubeVideo instanceof HTMLElement)
        )
            return;

        const videoId = getYoutubeId(url);

        if (!videoId) return;

        youtubeVideo.source = {
            src: `https://www.youtube-nocookie.com/embed/${videoId}`,
            engine: {
                youtube: {
                    cc_load_policy: 1,
                    rel: 0,
                    iv_load_policy: 3,
                },
            },
        };

        videoModal.showModal();
    }

    function closeVideo() {
        videoPlayer?.store?.pause();

        youtubeVideo?.setAttribute('src', '');
    }

    window.addEventListener('play-video', evt => {
        playVideo(evt.detail);
    });

    videoModal?.addEventListener('close', closeVideo);
</script>
